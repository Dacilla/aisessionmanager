[Unit]
Description=AI Session Pinger - keeps 5h rolling windows alive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alex
Environment=PATH=/home/alex/.local/bin:/home/alex/.nvm/versions/node/v24.6.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/ai-pinger.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-pinger
